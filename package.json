    "clsx": "^2.1.1",
    "dexie": "^4.4.0",
    "fflate": "^0.8.2",
    "immer": "^10.1.3",
    "lucide-react": "^0.544.0",
    "monaco-editor": "^0.56.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
